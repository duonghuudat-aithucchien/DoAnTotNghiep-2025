# Google Gemini API Key
GOOGLE_API_KEY=your_google_gemini_api_key

# MongoDB Connection URI
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# Phải trùng ACCESS_TOKEN của backend để xác thực lịch sử trò chuyện
ACCESS_TOKEN=your_jwt_access_token_secret
# Local only, optional: read ACCESS_TOKEN from the backend .env without copying it.
# Do not enable this in Docker/cloud; inject matching ACCESS_TOKEN instead.
# BACKEND_AUTH_ENV_FILE=../my-backend/.env
FRONTEND_URL=http://localhost:3000
PORT=5000
FLASK_DEBUG=false

# Runtime and provider (do not use the retired hard-coded Gemini 1.5 model)
MONGO_DB=test
CHATBOT_STORAGE=mongo
BACKEND_API_URL=http://localhost:3001/api
GEMINI_MODEL=gemini-2.5-flash
EMBEDDING_ENABLED=true
EMBEDDING_MODEL=intfloat/multilingual-e5-small
# Set an immutable model revision for reproducible benchmark runs.
# E5-small example: 614241f622f53c4eeff9890bdc4f31cfecc418b3
EMBEDDING_REVISION=
# Optional multilingual cross-encoder, e.g. BAAI/bge-reranker-v2-m3 (larger CPU load)
RERANKER_MODEL=
INDEX_REFRESH_SECONDS=60
INDEX_CACHE_DIR=.cache
RETRIEVAL_MIN_COSINE=0.70

# Cost, privacy and traffic budgets
MAX_MESSAGE_CHARS=2000
HISTORY_TURNS=8
CHAT_RATE_LIMIT=20
CONVERSATION_RETENTION_DAYS=30
LLM_TIMEOUT_SECONDS=20
LLM_MAX_OUTPUT_TOKENS=512
LLM_MAX_CALLS_PER_DAY=2000
LOG_LEVEL=INFO
