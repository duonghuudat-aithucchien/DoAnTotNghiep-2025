# Cổng chạy Backend Server
PORT=3001

# Chuỗi kết nối MongoDB Atlas
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# JWT Secrets cho xác thực
ACCESS_TOKEN=your_jwt_access_token_secret
REFRESH_TOKEN=your_jwt_refresh_token_secret

# PayPal Sandbox / Live Client ID
CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_VND_PER_USD=25000

# VNPay
VNP_TMN_CODE=your_vnpay_terminal_code
VNP_HASH_SECRET=your_vnpay_hash_secret
VNP_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNP_RETURN_URL=http://localhost:3000/orderSuccess

# VietQR
VIETQR_BANK_ID=your_bank_id
VIETQR_ACCOUNT_NO=your_account_number
VIETQR_ACCOUNT_NAME=your_account_name
VIETQR_TEMPLATE=compact2
VIETQR_BANK_NAME=your_bank_name

# Frontend được phép gọi API, phân cách bằng dấu phẩy
CORS_ORIGINS=http://localhost:3000

# Cấu hình gửi Email (Nodemailer qua Gmail SMTP)
MAIL_ACCOUNT=your_gmail@gmail.com
MAIL_PASSWORD=your_gmail_app_password
SUBSCRIBE_NOTIFICATION_EMAIL=your_admin_email@example.com

# Cấu hình lưu trữ ảnh Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
